# ----------------------------------------------------------------------
# Guzel Medical Spa (جوزال ميديكال سبا) — SPA Routing, Performance & Security
# Optimized for Hostinger Apache / LiteSpeed
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files & directories directly (/assets/sheets/*.webp, /assets/fonts/*.woff2, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA virtual paths to index.html
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript           .js .mjs
  AddType text/css                  .css
  AddType image/svg+xml             .svg
  AddType image/webp                .webp
  AddType application/json          .json
  AddType application/font-woff     .woff
  AddType application/font-woff2    .woff2
</IfModule>

<IfModule mod_headers.c>
  # Hardened HTTP Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self';"

  # HTML: Never cache entry shell so deployments propagate immediately
  <FilesMatch "\.(?:html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Versioned static assets, WebP sheets & WOFF2 fonts: 1-year immutable cache
  <FilesMatch "\.(?:js|mjs|css|svg|woff|woff2|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Gzip & Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/font-woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

Options -Indexes
